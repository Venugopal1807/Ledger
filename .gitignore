# Bytecode: embeds absolute paths and interpreter magic numbers, which would
# break the reproducible build (DESIGN.md section 24).
__pycache__/
*.py[cod]

# Build output. Reproducibility is verified by building twice and
# comparing bytes (tools/build.py --verify), not by a committed digest.
/dist/

# Ledger stores and their sidecars, in case one is created while testing.
*.ledger
*.ledger.lock
*.ledger.compact
*.ledger.salvage.*
